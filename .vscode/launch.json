{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright: Android device",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeVersion": "22",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "--project=android", "--workers=1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playwright: mobile Chrome",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeVersion": "22",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "--project=mobile", "--workers=1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
